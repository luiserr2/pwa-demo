# Base de Datos PostgreSQL (Local o Cloud SQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sisbirceca_db
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=sisbirceca_db

# Configuración de Servidor
PORT=3000
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google Cloud Storage (Para producción en GCP)
# GCS_BUCKET_EVIDENCIAS=sisbirceca-evidencias-prod
# GCS_PROJECT_ID=mi-proyecto-gcp
